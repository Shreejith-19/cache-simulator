# ==========================================
# Root .gitignore for CPU Cache Simulator
# ==========================================

# Prerequisites / Environments
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Node / Frontend Build & Dependencies
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.eslintcache
frontend/oxlint.json
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# C++ / CMake Build Artifacts
**/build/
**/bin/
**/out/
**/CMakeFiles/
**/*.dir/
**/CMakeCache.txt
**/cmake_install.cmake
**/Makefile
**/_deps/
CMakeUserPresets.json

# Visual Studio / MSVC Specific Files
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.ipch
*.aps
*.opendb
*.db
*.VC.db

# Compiled Binaries & Intermediates
*.obj
*.o
*.tlog
*.log
*.pdb
*.idb
*.ilk
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# Editor and System files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.user
*.userosv
*.bak
.DS_Store
Thumbs.db
Desktop.ini
